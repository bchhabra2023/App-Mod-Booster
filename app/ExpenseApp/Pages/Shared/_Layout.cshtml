<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Expense Manager</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        :root {
            --sidebar-bg: #0f172a;
            --sidebar-hover: #1e293b;
            --sidebar-active: #1d4ed8;
            --accent: #3b82f6;
            --header-height: 60px;
        }
        body { background: #f8fafc; font-family: 'Segoe UI', system-ui, sans-serif; }
        /* Sidebar */
        #sidebar {
            width: 240px; min-height: 100vh; background: var(--sidebar-bg);
            position: fixed; top: 0; left: 0; z-index: 100;
            display: flex; flex-direction: column;
        }
        #sidebar .brand {
            padding: 20px 24px; font-size: 1.2rem; font-weight: 700;
            color: #fff; border-bottom: 1px solid #1e293b;
            display: flex; align-items: center; gap: 10px;
        }
        #sidebar .brand i { color: var(--accent); font-size: 1.5rem; }
        #sidebar nav { padding: 16px 0; flex: 1; }
        #sidebar nav a {
            display: flex; align-items: center; gap: 12px;
            padding: 12px 24px; color: #94a3b8; text-decoration: none;
            font-size: 0.9rem; transition: all 0.2s;
        }
        #sidebar nav a:hover { background: var(--sidebar-hover); color: #fff; }
        #sidebar nav a.active { background: var(--sidebar-active); color: #fff; border-radius: 0; }
        #sidebar nav a i { font-size: 1.1rem; width: 20px; }
        /* Main content */
        #main-content {
            margin-left: 240px; min-height: 100vh;
            display: flex; flex-direction: column;
        }
        #topbar {
            height: var(--header-height); background: #fff;
            border-bottom: 1px solid #e2e8f0;
            display: flex; align-items: center; justify-content: space-between;
            padding: 0 28px; position: sticky; top: 0; z-index: 99;
        }
        #topbar .page-title { font-size: 1.1rem; font-weight: 600; color: #1e293b; }
        .content-area { padding: 28px; flex: 1; }
        /* Cards */
        .stat-card {
            background: #fff; border-radius: 12px; padding: 24px;
            border: 1px solid #e2e8f0; box-shadow: 0 1px 3px rgba(0,0,0,.05);
        }
        .stat-card .stat-value { font-size: 1.8rem; font-weight: 700; color: #1e293b; }
        .stat-card .stat-label { color: #64748b; font-size: 0.85rem; margin-top: 4px; }
        /* Table */
        .data-card {
            background: #fff; border-radius: 12px;
            border: 1px solid #e2e8f0; box-shadow: 0 1px 3px rgba(0,0,0,.05);
            overflow: hidden;
        }
        .data-card .card-header-custom {
            padding: 16px 24px; border-bottom: 1px solid #e2e8f0;
            display: flex; align-items: center; justify-content: space-between;
            background: #fff;
        }
        .data-card .card-header-custom h5 { font-weight: 600; color: #1e293b; margin: 0; }
        .table-custom { margin: 0; }
        .table-custom thead th {
            background: #f8fafc; color: #64748b; font-size: 0.78rem;
            font-weight: 600; text-transform: uppercase; letter-spacing: .05em;
            border-bottom: 1px solid #e2e8f0; padding: 12px 16px;
        }
        .table-custom tbody td { padding: 12px 16px; vertical-align: middle; color: #374151; border-color: #f1f5f9; }
        .table-custom tbody tr:hover { background: #f8fafc; }
        /* Badges */
        .badge-draft     { background: #f1f5f9; color: #64748b; }
        .badge-submitted { background: #dbeafe; color: #1d4ed8; }
        .badge-approved  { background: #dcfce7; color: #16a34a; }
        .badge-rejected  { background: #fee2e2; color: #dc2626; }
        /* Buttons */
        .btn-primary-custom {
            background: #1d4ed8; border: none; color: #fff;
            padding: 8px 20px; border-radius: 8px; font-weight: 500;
            transition: background 0.2s;
        }
        .btn-primary-custom:hover { background: #1e40af; color: #fff; }
        .btn-success-custom {
            background: #16a34a; border: none; color: #fff;
            padding: 6px 16px; border-radius: 6px; font-size: 0.85rem;
        }
        .btn-success-custom:hover { background: #15803d; color: #fff; }
        .btn-danger-custom {
            background: #dc2626; border: none; color: #fff;
            padding: 6px 16px; border-radius: 6px; font-size: 0.85rem;
        }
        /* Error banner */
        .error-banner {
            background: #fef2f2; border: 1px solid #fecaca; border-radius: 8px;
            padding: 12px 16px; margin-bottom: 20px;
            display: flex; align-items: flex-start; gap: 10px;
        }
        .error-banner i { color: #dc2626; margin-top: 2px; }
        .error-banner .error-text { color: #991b1b; font-size: 0.9rem; }
        /* Responsive */
        @@media (max-width: 768px) {
            #sidebar { display: none; }
            #main-content { margin-left: 0; }
        }
    </style>
</head>
<body>
    <!-- Sidebar -->
    <div id="sidebar">
        <div class="brand">
            <i class="bi bi-receipt-cutoff"></i>
            <span>Expense Manager</span>
        </div>
        <nav>
            <a href="/Index" class="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Index" ? "active" : "")">
                <i class="bi bi-speedometer2"></i> Dashboard
            </a>
            <a href="/Expenses/Index" class="@(ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/Expenses/Index") == true ? "active" : "")">
                <i class="bi bi-list-ul"></i> All Expenses
            </a>
            <a href="/Expenses/Add" class="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Expenses/Add" ? "active" : "")">
                <i class="bi bi-plus-circle"></i> Add Expense
            </a>
            <a href="/Expenses/Approve" class="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Expenses/Approve" ? "active" : "")">
                <i class="bi bi-check2-circle"></i> Approve
            </a>
            <a href="/Chat" class="@(ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/Chat") == true ? "active" : "")">
                <i class="bi bi-chat-dots"></i> AI Assistant
            </a>
            <a href="/swagger" target="_blank">
                <i class="bi bi-braces"></i> API Docs
            </a>
        </nav>
    </div>

    <!-- Main Content -->
    <div id="main-content">
        <div id="topbar">
            <span class="page-title">@ViewData["Title"]</span>
            <span style="color:#64748b;font-size:0.85rem;">
                <i class="bi bi-cloud-check me-1 text-success"></i>Azure App Service
            </span>
        </div>
        <div class="content-area">
            @RenderBody()
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
