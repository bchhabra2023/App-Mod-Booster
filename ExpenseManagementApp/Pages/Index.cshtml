@page
@model IndexModel
@{
    ViewData["Title"] = "Expense Management";
}

<div class="container py-4">
    <div id="error-banner" class="alert alert-danger d-none" role="alert"></div>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="display-6 fw-bold">Expense Management</h1>
            <p class="text-muted mb-0">Modernized .NET 8 app with API-first architecture and managed identity database access.</p>
        </div>
        <a class="btn btn-outline-primary" href="/chatui/index.html">Open Chat UI</a>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h2 class="h5">Submit expense</h2>
            <form id="create-expense-form" class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Employee</label>
                    <select id="user-select" class="form-select" required></select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Category</label>
                    <select id="category-select" class="form-select" required></select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Amount (GBP)</label>
                    <input id="amount-input" type="number" min="0" step="0.01" class="form-control" required />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Expense date</label>
                    <input id="date-input" type="date" class="form-control" required />
                </div>
                <div class="col-12">
                    <label class="form-label">Description</label>
                    <input id="description-input" type="text" class="form-control" maxlength="200" required />
                </div>
                <div class="col-12 text-end">
                    <button class="btn btn-primary" type="submit">Create expense</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-end mb-3">
                <h2 class="h5 mb-0">Expenses</h2>
                <div class="d-flex gap-2 align-items-end">
                    <div>
                        <label class="form-label">Status filter</label>
                        <select id="status-filter" class="form-select">
                            <option value="">All</option>
                            <option value="Draft">Draft</option>
                            <option value="Submitted">Submitted</option>
                            <option value="Approved">Approved</option>
                            <option value="Rejected">Rejected</option>
                        </select>
                    </div>
                    <button id="refresh-btn" class="btn btn-outline-secondary">Refresh</button>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-striped align-middle" id="expenses-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>User</th>
                            <th>Category</th>
                            <th>Status</th>
                            <th>Amount</th>
                            <th>Date</th>
                            <th>Description</th>
                            <th>Manager action</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/expense-app.js"></script>
}
